{
	"productName": "modpack-sync",
	"version": "2.0.0",
	"identifier": "com.modpack-sync.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1430",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Modpack Sync",
				"width": 1250,
				"height": 700,
				"minWidth": 1250,
				"minHeight": 700,
				"decorations": false
			}
		],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https:; connect-src 'self' ipc: http://ipc.localhost https:",
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["$APPDATA/**"],
					"requireLiteralLeadingDot": false
				}
			}
		}
	},
	"plugins": {
		"shell": {
			"open": true
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOTVBNzIyMTYyRDFDRTgKUldUb0hDMFdJcWVWSDRZNmJBd1BYRlJQN1hSdktoY1RGRDBVbHhPSjlOTWx1dHVycHdMZVBseWIK",
			"endpoints": ["https://raw.githubusercontent.com/Frenvius/tauri-mod-updater/master/public/updater-endpoint.json"]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
